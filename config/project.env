# Absolute project location.
export INTERNSHIP_ROOT="${HOME}/quard_um6p_intership"
export DEPENDENCIES_DIR="${INTERNSHIP_ROOT}/dependencies"

# Independent dependency locations.
export PX4_DIR="${DEPENDENCIES_DIR}/PX4-Autopilot"
export DDS_AGENT_DIR="${DEPENDENCIES_DIR}/Micro-XRCE-DDS-Agent"

# Independent ROS 2 workspace.
export ROS2_WS="${INTERNSHIP_ROOT}/ros2_ws"

# Communication configuration.
export ROS_DOMAIN_ID=23
export PX4_UXRCE_DDS_PORT=8888

# Fixed source branches.
export PX4_BRANCH="release/1.15"
export PX4_MSGS_BRANCH="release/1.15"
export DDS_AGENT_REVISION="v2.4.2"

# Prevent Gazebo from using an unrelated running server.
export GZ_PARTITION="um6p_internship_${USER}"
